# PaperTide Review local environment template.
# Copy selected values into shell exports or service-local .env files. Do not commit real secrets.

# Oracle / Spring API
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USERNAME=review_app
ORACLE_PASSWORD=ReviewApp12345
APP_USER=review_app
APP_USER_PASSWORD=ReviewApp12345
ORACLE_CONTAINER_NAME=review-oracle

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
REVIEW_ANALYSIS_BROKER_ENABLED=true
REVIEW_ANALYSIS_OUTBOX_DISPATCH_DELAY_MS=1000

# API runtime
SERVER_PORT=8080
REVIEW_JWT_SECRET=ReviewJwtSecretKeyForLocalDevOnly12345
REVIEW_JWT_ISSUER=review-api
REVIEW_JWT_EXPIRATION=PT24H
AGENT_INTERNAL_API_KEY=local-dev-internal-key

# Agent runtime
AGENT_PLATFORM_BROKER_ENABLED=true
AGENT_PLATFORM_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
AGENT_PLATFORM_BROKER_EXCHANGE=review.analysis.exchange
AGENT_PLATFORM_REQUEST_QUEUE=analysis.requested.agent
AGENT_PLATFORM_REQUEST_ROUTING_KEY=analysis.requested
AGENT_PLATFORM_COMPLETED_ROUTING_KEY=analysis.completed
AGENT_PLATFORM_COMPLETED_PUBLISH_INTERVAL_SECONDS=1.0
AGENT_PLATFORM_DB_USER=review_app
AGENT_PLATFORM_DB_PASSWORD=ReviewApp12345
AGENT_PLATFORM_DB_DSN=localhost:1521/FREEPDB1
AGENT_PLATFORM_MAX_ATTEMPTS=3

# Optional LLM provider. Leave unset for deterministic offline Agent behavior in tests and demos.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
LLM_MAX_TOKENS=1200

# Frontend
VITE_API_BASE=http://localhost:8080/api

# Optional repository-level real integration smoke.
RUN_ANALYSIS_E2E_SMOKE=0
API_SMOKE_PORT=18080
AGENT_SMOKE_PORT=18001
